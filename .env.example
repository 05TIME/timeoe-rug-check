# Public Firebase web config. Leave these blank to run Rug Check with explanations off.
# Copy this file to .env.local. Never commit .env.local, and never put a real debug token here.
# NEXT_PUBLIC_ values are read when the app is built or when `npm run dev` starts.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Fraud Defense / reCAPTCHA Enterprise score-based site key (no checkbox challenge).
# Required for the cloud Gemini fallback. Create it for timeoe-rug-check.vercel.app and vercel.app.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Name fallback only. Used when the Enterprise variable above is blank.
# The value is still passed to ReCaptchaEnterpriseProvider, so it must be an Enterprise key.
# NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Local demo only. Set to true to print a debug token, then replace true with that token.
# Do not set this on the production deployment.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# --- Server-only, all optional. The app works with none of these set. ---
# SOLANA_RPC_URL=
# Per-chain EVM RPC override (keyless public RPCs are used otherwise):
# EVM_RPC_URL_ETHEREUM=
# EVM_RPC_URL_BSC=
# EVM_RPC_URL_BASE=
# EVM_RPC_URL_ARBITRUM=
# EVM_RPC_URL_POLYGON=
# EVM_RPC_URL_OPTIMISM=
# EVM_RPC_URL_AVALANCHE=
# GoPlus access token for higher rate limits (public API works without it):
# GOPLUS_ACCESS_TOKEN=
